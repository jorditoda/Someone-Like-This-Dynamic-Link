---
import AppRedirectionPage from "@modules/app";
import BaseLayout from "../layouts/BaseLayout.astro";
import { appStoreUrl, playStoreUrl } from "../site";
---

<BaseLayout
  title="Someone Like This"
  description="Download Someone Like This."
  path="/app"
  chrome={false}
  noindex
>
  <AppRedirectionPage client:load config={{ appStoreLink: appStoreUrl(), googlePlayLink: playStoreUrl() }} />
</BaseLayout>
