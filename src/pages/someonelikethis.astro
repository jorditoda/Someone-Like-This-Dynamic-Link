---
import InvitePage from "@modules/invite";
import BaseLayout from "../layouts/BaseLayout.astro";
import { appStoreUrl, playStoreUrl } from "../site";

const title = "Uneix-te a la meva partida de Someone Like This";
const description =
  "Toca l'enllaç per unir-te a la partida. Join my game of Someone Like This.";
---

<BaseLayout title={title} description={description} path="/someonelikethis" chrome={false} noindex>
  <Fragment slot="head">
    <meta name="apple-itunes-app" content="app-id=6739965531" />
    <!-- Smart App Banner: l'app-argument ha de ser la URL actual (amb code o gameId). -->
    <script is:inline>
      document
        .querySelector('meta[name="apple-itunes-app"]')
        .setAttribute(
          "content",
          "app-id=6739965531, app-argument=" + window.location.href,
        );
    </script>
  </Fragment>
  <InvitePage client:only="react" config={{ appStoreLink: appStoreUrl(), googlePlayLink: playStoreUrl() }} />
</BaseLayout>
