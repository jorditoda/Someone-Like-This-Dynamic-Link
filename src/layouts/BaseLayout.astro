---
import "@styles/styles.css";
import { SITE } from "../site";
import { LANGS, getDict, absoluteUrl, type Lang } from "../i18n";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Ruta canònica (p. ex. "/es/"). */
  path: string;
  /** Rutes de les altres versions d'idioma, per a hreflang i el selector. */
  alternates?: Partial<Record<Lang, string>>;
  ogImage?: string;
  noindex?: boolean;
  chrome?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description,
  lang = "en",
  path,
  alternates,
  ogImage,
  noindex = false,
  chrome = true,
  jsonLd = [],
} = Astro.props;

const d = getDict(lang);
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage ?? `/og-${lang}.png`);
const otherLangs = alternates
  ? LANGS.filter((l) => l !== lang && alternates[l])
  : [];
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#eee9fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1840" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      alternates && (
        <>
          {LANGS.filter((l) => alternates[l]).map((l) => (
            <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l]!)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en ?? path)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={d.ogLocale} />
    {otherLangs.map((l) => <meta property="og:locale:alternate" content={getDict(l).ogLocale} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <slot name="head" />
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="bg-base-100 text-base-content">
    {chrome && <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] btn btn-primary"
    >
      {d.nav.skip}
    </a>}
    {chrome && <Navbar lang={lang} alternates={alternates} />}
    <slot />
    {chrome && <Footer lang={lang} alternates={alternates} />}
  </body>
</html>
