---
import { getDict, homePath, pagePath, absoluteUrl, LANGS, type Lang } from "../i18n";
import { OCCASIONS } from "../data/occasions";
import BaseLayout from "../layouts/BaseLayout.astro";
import StoreButtons from "./StoreButtons.astro";
import Shot from "./Shot.astro";

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const d = getDict(lang);
const occasion = OCCASIONS.find((o) => o.id === id)!;
const page = occasion.pages![lang];
const alternates = Object.fromEntries(
  LANGS.map((l) => [l, pagePath(l, occasion.pages![l].slug)]),
) as Record<Lang, string>;
const path = alternates[lang];
const related = OCCASIONS.filter((o) => o.pages && o.id !== id);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: d.occasion.breadcrumbHome, item: absoluteUrl(homePath(lang)) },
      { "@type": "ListItem", position: 2, name: page.h1, item: absoluteUrl(path) },
    ],
  },
];
---

<BaseLayout title={page.seoTitle} description={page.seoDescription} lang={lang} path={path} alternates={alternates} jsonLd={jsonLd}>
  <main id="main">
    <div class="mx-auto max-w-screen-lg px-4 pt-6">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={homePath(lang)} class="inline-flex min-h-11 items-center underline underline-offset-4">{d.occasion.breadcrumbHome}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{page.h1}</li>
        </ol>
      </nav>
    </div>

    <section class="mx-auto grid max-w-screen-lg items-start gap-10 px-4 pb-12 pt-4 md:grid-cols-[1fr_16rem]">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight md:text-5xl">{page.h1}</h1>
        {page.intro.map((p) => <p class="mt-4 text-lg">{p}</p>)}
        <StoreButtons lang={lang} class="mt-6" />
      </div>
      <div class="mx-auto w-full max-w-[14rem]">
        <div class="aspect-[1320/1900] overflow-hidden rounded-[1.5rem] shadow-lg">
          <Shot lang={lang} name="01-bingo" alt={d.occasion.shotAlt} priority sizes="224px" class="!h-full !rounded-none !shadow-none object-cover object-top" />
        </div>
      </div>
    </section>

    <section class="bg-base-200">
      <div class="mx-auto max-w-screen-md px-4 py-12">
        <h2 class="text-3xl font-extrabold">{d.occasion.examplesTitle}</h2>
        <p class="mt-2 opacity-90">{d.occasion.examplesHint}</p>
        <ol class="mt-6 grid gap-2 sm:grid-cols-2">
          {
            page.situations.map((s, i) => (
              <li class="flex gap-3 rounded-box bg-base-100 p-3">
                <span class="font-extrabold text-primary" aria-hidden="true">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 font-bold">{page.tip}</p>
      </div>
    </section>

    <section class="mx-auto max-w-screen-md px-4 py-12">
      <h2 class="text-3xl font-extrabold">{d.occasion.howTitle}</h2>
      <ol class="mt-6 space-y-4">
        {
          d.home.how.steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-extrabold text-primary-content">{i + 1}</span>
              <div>
                <h3 class="font-extrabold">{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mx-auto max-w-screen-md px-4 pb-12">
      <h2 class="text-2xl font-extrabold">{d.occasion.relatedTitle}</h2>
      <ul class="mt-3 flex flex-wrap gap-3">
        {
          related.map((o) => (
            <li>
              <a href={pagePath(lang, o.pages![lang].slug)} class="inline-flex min-h-11 items-center rounded-full border-2 border-primary px-4 font-bold text-primary hover:bg-base-200">
                {o.text[lang].card.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="download" class="bg-neutral text-neutral-content">
      <div class="mx-auto max-w-screen-lg px-4 py-14 text-center">
        <h2 class="text-3xl font-extrabold">{d.occasion.ctaTitle}</h2>
        <p class="mt-2 opacity-90">{d.occasion.ctaSub}</p>
        <StoreButtons lang={lang} class="mt-6 justify-center" />
      </div>
    </section>
  </main>
</BaseLayout>
